<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.emgi.timeline.view.IdeaEditorView"
      styleClass="editor-pane">

    <Label styleClass="field-label" text="Title"/>
    <TextField fx:id="titleField" styleClass="text-input"/>
    <Label fx:id="titleErrorLabel" styleClass="error-label"/>

    <Label styleClass="field-label" text="Tags"/>
    <FlowPane fx:id="tagPane" styleClass="tag-editor"/>
    <TextField fx:id="tagField" styleClass="text-input" promptText="add tag…"/>
    <Label fx:id="tagsErrorLabel" styleClass="error-label"/>

    <Label styleClass="field-label" text="Status"/>
    <HBox fx:id="statusBox" styleClass="status-row"/>

    <Label styleClass="field-label" text="Description"/>

    <ScrollPane fx:id="blockScroll" styleClass="block-scroll"
                fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="blockList" styleClass="block-list"/>
    </ScrollPane>

    <HBox styleClass="add-block-row">
        <Button fx:id="addTextButton" styleClass="secondary-button" text="+ Text"/>
        <Button fx:id="addLinkButton" styleClass="secondary-button" text="+ Link"/>
        <Button fx:id="addImageButton" styleClass="secondary-button" text="+ Image"/>
    </HBox>

    <Label fx:id="descriptionErrorLabel" styleClass="error-label"/>

    <HBox styleClass="dialog-buttons">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" styleClass="secondary-button" text="Cancel"
                cancelButton="true"/>
        <Button fx:id="saveButton" styleClass="primary-button" text="Save"
                defaultButton="true"/>
    </HBox>
</VBox>
