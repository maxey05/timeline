<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.emgi.timeline.view.IdeaEditorView"
      styleClass="editor-pane">

    <Label styleClass="field-label" text="Title"/>
    <TextField fx:id="titleField" styleClass="text-input"/>
    <Label fx:id="titleErrorLabel" styleClass="error-label"/>

    <Label styleClass="field-label" text="Tags"/>
    <FlowPane fx:id="tagPane" styleClass="tag-editor"/>
    <TextField fx:id="tagField" styleClass="text-input" promptText="add tag…"/>
    <Label fx:id="tagsErrorLabel" styleClass="error-label"/>

    <Label styleClass="field-label" text="Status"/>
    <HBox fx:id="statusBox" styleClass="status-row"/>

    <Label styleClass="field-label" text="Description"/>

    <!--
        One box, and a button floating over its bottom-right corner. The button is a
        sibling in a StackPane rather than a row underneath so that the description reads
        as a single uninterrupted writing surface, which was the whole point of dropping
        the block editor. Its margin clears the writing surface's own scrollbar.

        The writing surface itself is NOT declared here. It is a DescriptionArea, a
        GenericStyledArea generic in three type parameters with no no-arg constructor, so
        FXML cannot build one; IdeaEditorView.buildDescriptionArea inserts it at index 0 of
        this stack, underneath the button. This placeholder is all the FXML can own.
    -->
    <StackPane fx:id="descriptionStack" styleClass="description-stack" VBox.vgrow="ALWAYS">
        <Button fx:id="insertImageButton" styleClass="insert-image-button" text="+"
                StackPane.alignment="BOTTOM_RIGHT">
            <StackPane.margin>
                <Insets bottom="12.0" right="16.0"/>
            </StackPane.margin>
        </Button>
    </StackPane>

    <Label fx:id="descriptionErrorLabel" styleClass="error-label"/>

    <HBox styleClass="dialog-buttons">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" styleClass="secondary-button" text="Cancel"
                cancelButton="true"/>
        <Button fx:id="saveButton" styleClass="primary-button" text="Save"
                defaultButton="true"/>
    </HBox>
</VBox>
