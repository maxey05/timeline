<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.TextFlow?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.emgi.timeline.view.MainView"
           styleClass="root-stack">

    <BorderPane fx:id="contentRoot" styleClass="root-pane">

        <top>
            <VBox>
                <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_LEFT">
                    <Label styleClass="title-bar-name" text="timeline"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="minimizeButton" styleClass="caption-button" focusTraversable="false">
                        <graphic>
                            <StackPane styleClass="caption-box">
                                <SVGPath styleClass="caption-glyph" content="M 0 5 L 10 5"/>
                            </StackPane>
                        </graphic>
                    </Button>

                    <Button fx:id="maximizeButton" styleClass="caption-button" focusTraversable="false">
                        <graphic>
                            <StackPane styleClass="caption-box">
                                <SVGPath fx:id="maximizeGlyph" styleClass="caption-glyph"
                                         content="M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"/>
                            </StackPane>
                        </graphic>
                    </Button>

                    <Button fx:id="closeButton" styleClass="caption-button" focusTraversable="false">
                        <graphic>
                            <StackPane styleClass="caption-box">
                                <SVGPath styleClass="caption-glyph"
                                         content="M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5"/>
                            </StackPane>
                        </graphic>
                    </Button>
                </HBox>

                <HBox styleClass="app-header" alignment="CENTER_LEFT">
                    <TextFlow fx:id="appTitle" styleClass="app-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newIdeaButton" styleClass="primary-button" text="+ New Idea"/>

                    <Button fx:id="settingsButton" styleClass="icon-button">
                        <graphic>
                            <StackPane styleClass="icon-box">
                                <SVGPath styleClass="icon-glyph"
                                         scaleX="0.6667"
                                         scaleY="0.6667"
                                         content="M 19.4 15 a 1.65 1.65 0 0 0 0.33 1.82 l 0.06 0.06 a 2 2 0 0 1 0 2.83 2 2 0 0 1 -2.83 0 l -0.06 -0.06 a 1.65 1.65 0 0 0 -1.82 -0.33 1.65 1.65 0 0 0 -1 1.51 V 21 a 2 2 0 0 1 -2 2 2 2 0 0 1 -2 -2 v -0.09 A 1.65 1.65 0 0 0 9 19.4 a 1.65 1.65 0 0 0 -1.82 0.33 l -0.06 0.06 a 2 2 0 0 1 -2.83 0 2 2 0 0 1 0 -2.83 l 0.06 -0.06 a 1.65 1.65 0 0 0 0.33 -1.82 1.65 1.65 0 0 0 -1.51 -1 H 3 a 2 2 0 0 1 -2 -2 2 2 0 0 1 2 -2 h 0.09 A 1.65 1.65 0 0 0 4.6 9 a 1.65 1.65 0 0 0 -0.33 -1.82 l -0.06 -0.06 a 2 2 0 0 1 0 -2.83 2 2 0 0 1 2.83 0 l 0.06 0.06 a 1.65 1.65 0 0 0 1.82 0.33 H 9 a 1.65 1.65 0 0 0 1 -1.51 V 3 a 2 2 0 0 1 2 -2 2 2 0 0 1 2 2 v 0.09 a 1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82 -0.33 l 0.06 -0.06 a 2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83 l -0.06 0.06 a 1.65 1.65 0 0 0 -0.33 1.82 V 9 a 1.65 1.65 0 0 0 1.51 1 H 21 a 2 2 0 0 1 2 2 2 2 0 0 1 -2 2 h -0.09 a 1.65 1.65 0 0 0 -1.51 1 z M 15 12 a 3 3 0 1 1 -6 0 3 3 0 0 1 6 0 z"/>
                            </StackPane>
                        </graphic>
                    </Button>
                </HBox>

                <VBox styleClass="filter-bar">
                    <HBox styleClass="toolbar" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   styleClass="search-field"
                                   promptText="Search titles…"
                                   HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="sortToggle" styleClass="sort-toggle">
                            <graphic>
                                <HBox fx:id="sortToggleBox" styleClass="sort-toggle-box" alignment="CENTER_LEFT">
                                    <Label fx:id="sortLabel" styleClass="sort-toggle-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <SVGPath fx:id="sortChevron" styleClass="sort-chevron"
                                             content="M 2 4 L 5 7 L 8 4"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>
                    </HBox>

                    <HBox fx:id="tagFilterRow" styleClass="tag-filter-row" alignment="TOP_LEFT">
                        <Label styleClass="toolbar-label" text="Tags"/>
                        <FlowPane fx:id="tagFilterPane" styleClass="tag-filter-pane" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </VBox>
        </top>

        <center>
            <StackPane styleClass="list-container">
                <ListView fx:id="ideaListView" styleClass="idea-list"/>

                <VBox fx:id="emptyState" styleClass="empty-state" alignment="CENTER">
                    <Label styleClass="empty-state-title" text="No ideas yet"/>
                    <Label styleClass="empty-state-hint" text="Your ideas will appear here."/>
                </VBox>

                <VBox fx:id="noMatchesState" styleClass="no-matches" alignment="CENTER">
                    <Label styleClass="no-matches-title" text="No ideas match your filters"/>
                    <Button fx:id="clearFiltersButton" styleClass="secondary-button" text="Clear filters"/>
                </VBox>
            </StackPane>
        </center>

    </BorderPane>

    <Pane fx:id="sortMenuLayer" styleClass="sort-menu-layer" pickOnBounds="false" visible="false"/>

    <StackPane fx:id="detailOverlay" styleClass="detail-overlay" visible="false">

        <Region fx:id="detailScrim" styleClass="detail-scrim"/>

        <VBox fx:id="detailPanel" styleClass="detail-panel">

            <HBox styleClass="detail-panel-header" alignment="TOP_LEFT">
                <VBox styleClass="detail-heading" HBox.hgrow="ALWAYS">
                    <Label fx:id="detailTitle" styleClass="detail-title" wrapText="true"/>
                    <Label fx:id="detailMeta" styleClass="detail-meta"/>
                </VBox>
                <Button fx:id="detailCloseButton" styleClass="detail-close-button" text="✕"/>
            </HBox>

            <FlowPane fx:id="detailTags" styleClass="idea-tags"/>

            <ScrollPane fx:id="detailScroll" styleClass="detail-scroll"
                        fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="descriptionWell" styleClass="description-well"/>
            </ScrollPane>

            <HBox styleClass="detail-footer" alignment="CENTER_RIGHT">
                <Button fx:id="detailEditButton" styleClass="secondary-button" text="Edit…"/>
            </HBox>

        </VBox>

    </StackPane>

    <StackPane fx:id="editorOverlay" styleClass="editor-overlay" visible="false">

        <Region fx:id="editorScrim" styleClass="detail-scrim"/>

        <StackPane fx:id="editorHost"/>

    </StackPane>

    <StackPane fx:id="namePromptOverlay" styleClass="name-prompt-overlay" visible="false">

        <Region fx:id="namePromptScrim" styleClass="detail-scrim"/>

        <VBox fx:id="namePromptPanel" styleClass="name-prompt-panel">

            <Label styleClass="name-prompt-title" text="Welcome to your timeline."/>

            <TextField fx:id="nameField" styleClass="name-input" promptText="enter your name…"/>

            <HBox styleClass="name-prompt-footer" alignment="CENTER_RIGHT">
                <Button fx:id="nameOkButton" styleClass="primary-button" text="OK"/>
            </HBox>

        </VBox>

    </StackPane>
        <StackPane fx:id="confirmOverlay" styleClass="confirm-overlay" visible="false">

        <Region fx:id="confirmScrim" styleClass="confirm-scrim"/>

        <VBox fx:id="confirmPanel" styleClass="confirm-panel">

            <Label fx:id="confirmTitle" styleClass="confirm-title" wrapText="true"/>

            <Label fx:id="confirmMessage" styleClass="confirm-message" wrapText="true"/>

            <HBox styleClass="confirm-footer" alignment="CENTER_RIGHT">
                <Button fx:id="confirmAcceptButton" styleClass="secondary-button, confirm-destructive"/>
                <Button fx:id="confirmCancelButton" styleClass="primary-button"/>
            </HBox>

        </VBox>

    </StackPane>

</StackPane>
